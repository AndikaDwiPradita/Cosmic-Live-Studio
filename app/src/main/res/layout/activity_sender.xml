<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:padding="24dp">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/dark_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:title="@string/mode_sender"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/btn_disconnect" />

    <!-- Main Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Status Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/dark_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvSenderStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_waiting"
                        android:textAppearance="@style/TextAppearance.CosmicLiveStudio.Title"
                        android:textColor="@color/status_connecting" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Pastikan HP 1 dan HP 2 terhubung ke jaringan yang sama (Hotspot/Wi-Fi/USB Tethering)"
                        android:textAppearance="@style/TextAppearance.CosmicLiveStudio.BodySecondary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Connection Info Card (IP, Port, Large QR Code) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/dark_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/connection_info_title"
                        android:textAppearance="@style/TextAppearance.CosmicLiveStudio.Title" />

                    <!-- IP Address -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:text="@string/ip_local_label"
                            android:textAppearance="@style/TextAppearance.CosmicLiveStudio.Body" />

                        <TextView
                            android:id="@+id/tvLocalIp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mendeteksi..."
                            android:textAppearance="@style/TextAppearance.CosmicLiveStudio.Body"
                            android:textColor="@color/secondary"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Port -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:text="@string/tcp_port_label"
                            android:textAppearance="@style/TextAppearance.CosmicLiveStudio.Body" />

                        <TextView
                            android:id="@+id/tvPort"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Port: 45455"
                            android:textAppearance="@style/TextAppearance.CosmicLiveStudio.Body"
                            android:textColor="@color/secondary"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Network diagnostics (interface + alternative IPs) -->
                    <TextView
                        android:id="@+id/tvNetworkInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.CosmicLiveStudio.BodySecondary" />

                    <!-- Large QR Code -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/qr_code_label"
                            android:textAppearance="@style/TextAppearance.CosmicLiveStudio.BodySecondary" />

                        <ImageView
                            android:id="@+id/ivQrCode"
                            android:layout_width="280dp"
                            android:layout_height="280dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone"
                            android:background="@color/dark_surface_variant"
                            android:padding="24dp" />
                    </LinearLayout>

                    <!-- Copy IP:Port button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnCopyConnectionInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_copy_ip_port"
                            style="@style/Widget.CosmicLiveStudio.Button.Secondary" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Stream Settings Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/dark_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Pengaturan Stream"
                        android:textAppearance="@style/TextAppearance.CosmicLiveStudio.Title" />

                    <!-- Resolution Spinner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="16dp"
                            android:text="@string/resolution_label"
                            android:textAppearance="@style/TextAppearance.CosmicLiveStudio.Body" />

                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/spinnerResolution"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/spinner_background"
                            android:padding="12dp" />
                    </LinearLayout>

                    <!-- FPS Spinner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="16dp"
                            android:text="@string/fps_label"
                            android:textAppearance="@style/TextAppearance.CosmicLiveStudio.Body" />

                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/spinnerFps"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/spinner_background"
                            android:padding="12dp" />
                    </LinearLayout>

                    <!-- Bitrate Spinner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="16dp"
                            android:text="@string/bitrate_label"
                            android:textAppearance="@style/TextAppearance.CosmicLiveStudio.Body" />

                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/spinnerBitrate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/spinner_background"
                            android:padding="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Control Button -->
            <Button
                android:id="@+id/btnToggleSharing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/btn_start_sharing"
                style="@style/Widget.CosmicLiveStudio.Button.Primary" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>